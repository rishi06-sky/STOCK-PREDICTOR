# =============================================================================
# Stock Intelligence Platform -- environment template
#
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env
#
# The platform runs with zero paid services on the defaults below.
# =============================================================================

# --- core -------------------------------------------------------------------
ENVIRONMENT=development           # development | test | production
DEBUG=false
API_PREFIX=/api/v1

# --- datastores -------------------------------------------------------------
POSTGRES_USER=stockintel
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=stockintel
DATABASE_URL=postgresql+psycopg://stockintel:change-this-password@postgres:5432/stockintel
REDIS_URL=redis://redis:6379/0

# --- security ---------------------------------------------------------------
# REQUIRED in production. Generate with:  openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- market data providers --------------------------------------------------
# Ordered failover chain. The first provider returning valid data wins.
#   yahoo  -- no key. NSE (.NS), BSE (.BO), NYSE, NASDAQ. ~15-min delayed
#             intraday, reliable EOD. Undocumented endpoint with no SLA;
#             review Yahoo's terms before commercial use.
#   stooq  -- no key. END-OF-DAY ONLY. Used as a daily-bar fallback.
MARKET_DATA_PROVIDERS=yahoo,stooq

# Optional, keyed providers. Leave blank to skip them entirely.
# Alpha Vantage free tier is ~25 requests per DAY -- a fallback, not a feed.
ALPHA_VANTAGE_API_KEY=
# Finnhub free tier is ~60/min, US listings only, ~20-min delayed.
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=

PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=3
YAHOO_RATE_LIMIT_PER_MINUTE=60
STOOQ_RATE_LIMIT_PER_MINUTE=30

# TEST ONLY. Replays generated data instead of calling the network.
# Production refuses to start with this enabled.
ENABLE_FIXTURE_PROVIDER=false

# --- data freshness ---------------------------------------------------------
# A quote older than this is never presented or traded as current.
QUOTE_STALENESS_SECONDS=900
EOD_STALENESS_HOURS=72
# Signal generation halts entirely beyond this age.
SIGNAL_HALT_STALENESS_SECONDS=3600

# --- signals ----------------------------------------------------------------
SIGNAL_MIN_CONFIDENCE=0.55        # below this the engine emits NO_ACTION
SIGNAL_TTL_MINUTES=240
SIGNAL_MAX_PER_RUN=200

# --- risk limits ------------------------------------------------------------
RISK_PER_TRADE_PCT=0.01           # equity risked per trade, to the stop
RISK_MAX_POSITION_PCT=0.10        # cap on a single position
RISK_MAX_SECTOR_PCT=0.30
RISK_MAX_PORTFOLIO_EXPOSURE_PCT=0.95
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.20        # entries halt beyond this drawdown
RISK_MIN_REWARD_TO_RISK=1.5
RISK_MAX_OPEN_POSITIONS=20
RISK_MIN_ORDER_NOTIONAL=100

# --- trading ----------------------------------------------------------------
# Live trading needs BOTH switches set, plus a configured broker adapter.
# Leave these alone unless you intend to risk real money.
TRADING_MODE=paper                # paper | live
LIVE_TRADING_ENABLED=false
KILL_SWITCH_ENGAGED=false         # set true to halt ALL order placement
PAPER_STARTING_CASH=1000000
COMMISSION_BPS=3                  # 0.03% per side
SLIPPAGE_BPS=5                    # 0.05% adverse

# --- machine learning -------------------------------------------------------
ML_MODEL_DIR=/app/model_store
ML_MIN_TRAINING_ROWS=750
ML_WALK_FORWARD_SPLITS=5
ML_EMBARGO_DAYS=5                 # gap between train and test windows
ML_HORIZONS_DAYS=1,3,5,21
ML_RETRAIN_CRON_HOUR=2
ML_DRIFT_PSI_THRESHOLD=0.25

# --- notifications ----------------------------------------------------------
NOTIFICATIONS_ENABLED=true
ALERT_DEDUPE_WINDOW_MINUTES=60

# Email (any SMTP provider). Leave blank to disable the channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Telegram: create a bot with @BotFather, then message it to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true
INGEST_INTRADAY_INTERVAL_MINUTES=15
PIPELINE_INTERVAL_MINUTES=30
INGEST_EOD_CRON_HOUR=23
NEWS_INTERVAL_MINUTES=60

# --- frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
